# Copy to .env.local and fill values locally. Keep committed values empty.

# Storage
STORAGE_MODE=hybrid
DATABASE_URL=sqlite:///./data/index/knowledgenexus.db

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledgenexus

# CORS — comma-separated origins (e.g. http://localhost:3000,http://localhost:8080) or * for all
CORS_ORIGINS=*


# Embedding
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=./data/index/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./data/index/models
EMBEDDING_BATCH_SIZE=32

# LLM / Agent Builder
LLM_PROVIDER=agent_builder
AGENT_BUILDER_API_URL=https://agent.sec.samsung.net
AGENT_BUILDER_API_KEY=your-api-key-here
AGENT_BUILDER_AGENT_ID=your-agent-id-here
AGENT_BUILDER_TIMEOUT=120

AKP_CONTRACT_ROOT=
AKP_EXPORT_ROOT=
AKP_DATASET_NAME=
AKP_USE_LATEST=
AKP_DATASET_VERSION=
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
GIT_REMOTE_URL=
GIT_PAT=
JIRA_BASE_URL=
JIRA_PAT=

# CLI — KnowledgeNexus API URL for the `kn` agent CLI
# Set to the shared API server address. Copy this file to .env and adjust if needed.
KNOWLEDGENEXUS_API_URL=http://107.98.74.75:8000
