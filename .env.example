# Copy to .env.local and fill values locally. Keep committed values empty.

# Storage
STORAGE_MODE=hybrid
DATABASE_URL=sqlite:///./data/index/knowledgenexus.db

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=Confluence
RETRIEVAL_MODE=hybrid

# CORS — comma-separated origins (e.g. http://localhost:3000,http://localhost:8080) or * for all
CORS_ORIGINS=*

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=./data/index/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./data/index/models
EMBEDDING_BATCH_SIZE=32

# Reranker (cross-encoder, post-retrieval stage)
# When enabled, the system retrieves top-N candidates then reranks with
# BAAI/bge-reranker-v2-m3 for +10-20 MRR improvement. No re-ingest needed.
# Download the model and point RERANKER_MODEL_PATH to the local folder,
# or leave it unset to auto-download from HuggingFace.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=./data/index/models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16
RERANK_CANDIDATE_COUNT=50

AKP_CONTRACT_ROOT=
AKP_EXPORT_ROOT=
AKP_DATASET_NAME=
AKP_USE_LATEST=
AKP_DATASET_VERSION=
# Confluence subtree ingest (UI: "Ingest cây trang Confluence từ URL").
# All four are required; the API refuses a submission with 503 listing whatever
# is missing, and GET /api/v1/health reports it as confluence_ingest.
# The PAT is read from this file only -- there is no way to enter it in the UI.
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
# Must be an ABSOLUTE path OUTSIDE the repository checkout, with an existing
# parent directory: snapshot workspaces are written outside version control by
# design, so a path inside the repo is rejected. Windows e.g. D:/kn-data/confluence-snapshots
CONFLUENCE_SNAPSHOT_ROOT=
CONFLUENCE_MAX_PAGES=200
GIT_REMOTE_URL=
GIT_PAT=
JIRA_BASE_URL=
JIRA_PAT=

# CLI — KnowledgeNexus API URL for the `kn` agent CLI
# Set to the shared API server address. Copy this file to .env and adjust if needed.
KNOWLEDGENEXUS_API_URL=http://107.98.74.75:8000
