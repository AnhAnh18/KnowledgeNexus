+
+_SHA256 = re.compile(r"\A[0-9a-f]{64}\Z")
+_ATTACHMENTS_SUBDIR = ("confluence", "attachments")
+_READ_CHUNK_BYTES = 64 * 1024
+_MAX_READ_OVERHEAD = 1 * 1024 * 1024
