+from knowledgenexus.foundation.ports.media_processing_port import (
+    ImageOcrPort,
+    PdfTextExtractionPort,
+)
+from knowledgenexus.foundation.infrastructure.processors.drawio_xml_processor import (
+    DrawioXmlProcessor,
+)
