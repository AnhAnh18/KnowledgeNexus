+def test_published_reader_rejects_invalid_version_and_snapshot_path() -> None:
+    root = _fixture().parents[0]
+    reader = PublishedSnapshotReader(
+        dataset_root=root,
+        validator=FoundationSchemaValidator(),
+    )
+    with pytest.raises(ValueError):
