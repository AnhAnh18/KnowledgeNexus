+        git_adapter=_Adapter(git),
+    ).execute(request)
+    assert full_export.dataset_version == _BASE_VERSION
+
+    prior = _PriorSnapshot(full)
+    delta_request = replace(
+        request,
+        generated_at="2026-08-05T00:01:00Z",
+        export_mode="delta",
+        base_dataset_version=_BASE_VERSION,
+    )
+    inventory = (
