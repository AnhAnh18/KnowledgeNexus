# Copy to .env.docker (kept out of git). This file ONLY overrides the values
# that must differ inside the container from your local .env — everything
# else (Confluence, Storage, Qdrant collection, CORS, model names, reranker
# toggle, ...) is read from .env itself, which docker-compose.yml also loads
# as env_file for the `api` service. Do not duplicate those here.
#
# QDRANT_URL is forced separately in docker-compose.yml's `environment:`
# block (http://qdrant:6333) — no need to set it here.

# .env points these at host-relative paths (./docker/models/...) for local
# runs. Inside the container the same weights live at these absolute paths
# (baked in by docker/api/Dockerfile), so override them here.
EMBEDDING_MODEL_PATH=/app/models/bge-m3
RERANKER_MODEL_PATH=/app/models/bge-reranker-v2-m3
